{
  "name": "geo-publisher-desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "GEO Publisher desktop application with a built-in persistent browser",
  "author": "Lingxi",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "sh scripts/build-cli.sh",
    "dev": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:mac": "npm run build && npm run build:cli && electron-builder --mac",
    "package:win": "npm run build && npm run build:cli && electron-builder --win"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "electron": "43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "com.lingxi.geo-publisher",
    "productName": "GEO Publisher",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/cli",
        "to": "cli",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
