{
  "name": "geo-publisher-desktop",
  "version": "0.1.0-beta.6",
  "private": true,
  "description": "GEO Publisher desktop application with a built-in persistent browser",
  "author": "Lingxi",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "sh scripts/build-cli.sh",
    "dev": "npm run build && npm run build:cli && electron .",
    "pretest": "node node_modules/electron/install.js",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:cli && node tests/electron-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:mac": "npm run build && npm run build:cli && electron-builder --mac --arm64",
    "package:win": "npm run build && npm run build:cli && electron-builder --win --x64",
    "version:set": "node scripts/set-version.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:cli"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "electron": "43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "build": {
    "appId": "com.lingxi.geo-publisher",
    "productName": "GEO Publisher",
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "integrations",
        "to": "integrations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://lingxi-1303034624.cos.ap-guangzhou.myqcloud.com/geo-publisher/releases/stable"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "dist/cli",
          "to": "cli",
          "filter": [
            "geo-publisher-darwin-arm64"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "dist/cli",
          "to": "cli",
          "filter": [
            "geo-publisher-windows-amd64.exe"
          ]
        }
      ],
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GEO Publisher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
